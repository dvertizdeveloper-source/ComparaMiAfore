{
  "name": "comparamiafore",
  "version": "3.0.0",
  "private": true,
  "description": "ComparaMiAfore - Comparación de AFORE/SIEFORE basada en IRN oficial",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:web": "pnpm --filter @cma/web dev",
    "dev:admin": "pnpm --filter @cma/admin dev",
    "dev:worker": "pnpm --filter @cma/worker dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @cma/db generate",
    "db:migrate": "pnpm --filter @cma/worker db:migrate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
